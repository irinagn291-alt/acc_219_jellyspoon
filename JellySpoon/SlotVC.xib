<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="32700.00" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_1" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22685"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="SlotVC" customModule="JellySpoon" customModuleProvider="target">
            <connections>
                <outlet property="view" destination="root" id="oview"/>
                <outlet property="titleLbl" destination="ttl" id="otitleLbl"/>
                <outlet property="nowBtn" destination="now" id="onowBtn"/>
                <outlet property="planBtn" destination="pln" id="oplanBtn"/>
                <outlet property="slotBox" destination="box" id="oslotBox"/>
                <outlet property="dayLbl" destination="dl" id="odayLbl"/>
                <outlet property="daySlider" destination="ds" id="odaySlider"/>
                <outlet property="doneBtn" destination="don" id="odoneBtn"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="root">
            <rect key="frame" x="0.0" y="0.0" width="390" height="844"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Where" textAlignment="natural" lineBreakMode="wordWrap" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" translatesAutoresizingMaskIntoConstraints="NO" id="ttl">
                    <rect key="frame" x="20" y="80" width="350" height="24"/>
                    <fontDescription key="fontDescription" type="system" pointSize="20"/>
                    <nil key="textColor"/>
                    <nil key="highlightedColor"/>
                </label>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="now">
                    <rect key="frame" x="20" y="700" width="160" height="56"/>
                    <constraints>
                        <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="48" id="nowh"/>
                    </constraints>
                    <state key="normal" title="Now"/>
                </button>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="pln">
                    <rect key="frame" x="20" y="700" width="160" height="56"/>
                    <constraints>
                        <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="48" id="plnh"/>
                    </constraints>
                    <state key="normal" title="Plan"/>
                </button>
                <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" distribution="fillEqually" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="box">
                    <rect key="frame" x="20" y="400" width="350" height="80"/>
                </stackView>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="day" textAlignment="natural" lineBreakMode="wordWrap" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" translatesAutoresizingMaskIntoConstraints="NO" id="dl">
                    <rect key="frame" x="20" y="80" width="350" height="24"/>
                    <fontDescription key="fontDescription" type="system" pointSize="20"/>
                    <nil key="textColor"/>
                    <nil key="highlightedColor"/>
                </label>
                <slider opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" minValue="0" maxValue="6" translatesAutoresizingMaskIntoConstraints="NO" id="ds">
                    <rect key="frame" x="18" y="520" width="354" height="31"/>
                    <constraints>
                        <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="44" id="dsh"/>
                    </constraints>
                </slider>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="don">
                    <rect key="frame" x="20" y="700" width="160" height="56"/>
                    <constraints>
                        <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="48" id="donh"/>
                    </constraints>
                    <state key="normal" title="Park"/>
                </button>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safe"/>
            <color key="backgroundColor" systemColor="systemBackgroundColor"/>
            <constraints>

                <constraint firstItem="ttl" firstAttribute="top" secondItem="safe" secondAttribute="top" constant="8" id="t1"/>
                <constraint firstItem="ttl" firstAttribute="leading" secondItem="safe" secondAttribute="leading" constant="16" id="t2"/>
                <constraint firstItem="safe" firstAttribute="trailing" secondItem="ttl" secondAttribute="trailing" constant="16" id="t3"/>
                <constraint firstItem="now" firstAttribute="top" secondItem="ttl" secondAttribute="bottom" constant="10" id="t4"/>
                <constraint firstItem="now" firstAttribute="leading" secondItem="safe" secondAttribute="leading" constant="16" id="t5"/>
                <constraint firstItem="pln" firstAttribute="leading" secondItem="now" secondAttribute="trailing" constant="10" id="t6"/>
                <constraint firstItem="safe" firstAttribute="trailing" secondItem="pln" secondAttribute="trailing" constant="16" id="t7"/>
                <constraint firstItem="now" firstAttribute="width" secondItem="pln" secondAttribute="width" id="t8"/>
                <constraint firstItem="pln" firstAttribute="centerY" secondItem="now" secondAttribute="centerY" id="t9"/>
                <constraint firstItem="box" firstAttribute="top" secondItem="now" secondAttribute="bottom" constant="12" id="t10"/>
                <constraint firstItem="box" firstAttribute="leading" secondItem="safe" secondAttribute="leading" constant="16" id="t11"/>
                <constraint firstItem="safe" firstAttribute="trailing" secondItem="box" secondAttribute="trailing" constant="16" id="t12"/>
                <constraint firstItem="dl" firstAttribute="top" secondItem="box" secondAttribute="bottom" constant="10" id="t13"/>
                <constraint firstItem="dl" firstAttribute="leading" secondItem="ttl" secondAttribute="leading" id="t14"/>
                <constraint firstItem="dl" firstAttribute="trailing" secondItem="ttl" secondAttribute="trailing" id="t15"/>
                <constraint firstItem="ds" firstAttribute="top" secondItem="dl" secondAttribute="bottom" constant="6" id="t16"/>
                <constraint firstItem="ds" firstAttribute="leading" secondItem="safe" secondAttribute="leading" constant="16" id="t17"/>
                <constraint firstItem="safe" firstAttribute="trailing" secondItem="ds" secondAttribute="trailing" constant="16" id="t18"/>
                <constraint firstItem="don" firstAttribute="top" secondItem="ds" secondAttribute="bottom" constant="12" id="t19"/>
                <constraint firstItem="don" firstAttribute="leading" secondItem="safe" secondAttribute="leading" constant="16" id="t20"/>
                <constraint firstItem="safe" firstAttribute="trailing" secondItem="don" secondAttribute="trailing" constant="16" id="t21"/>
                <constraint firstItem="safe" firstAttribute="bottom" relation="greaterThanOrEqual" secondItem="don" secondAttribute="bottom" constant="12" id="t22"/>

            </constraints>
        </view>
    </objects>
    <resources>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
